{
  "name": "csc369-scheduling-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:e2e": "next dev -p 4173",
    "build": "vinext build",
    "build:vercel": "next build",
    "start": "vinext start",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:stress && npm run build && npm run test:rendered",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "lint:ci": "eslint app lib tests vitest.config.ts vitest.stress.config.ts playwright.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
